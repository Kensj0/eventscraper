rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{document=**} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Källkonfiguration är bara till för Cloud Functions (admin SDK, som
    // kringgår dessa regler helt) — ingen klient ska kunna läsa eller
    // ändra vilka källor som är aktiva.
    match /sources/{document=**} {
      allow read, write: if false;
    }

    // Kandidat-organisationer från källupptäckten (DEL 1/DEL 2) — samma
    // princip som "sources": bara Cloud Functions/admin-skript ska nå den.
    match /candidate-sources/{document=**} {
      allow read, write: if false;
    }

    // Databaser (föreningsregister, kataloger, API:er) som källupptäckten
    // hittat per region/organisationstyp — samma princip som ovan.
    match /region-databases/{document=**} {
      allow read, write: if false;
    }

    // Bannerbild + placering för sidhuvudet (app/components/HeroBanner.tsx).
    // Publikt läsbar (den publika sidan renderar den), men bara inloggad
    // admin (app/admin/page.tsx) får ändra den. Enda Firebase Auth-kontot
    // som finns är adminkontot (se functions/scripts/create-admin.ts) — det
    // finns ingen självregistrering, så "inloggad" == admin.
    match /config/site {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // På/av för de schemalagda ingestion-körningarna (functions/src/index.ts).
    // Behöver inte vara publikt läsbar — bara adminpanelen använder den.
    match /config/scheduling {
      allow read, write: if request.auth != null;
    }

    // Skrivs bara av Cloud Functions (admin SDK), men adminpanelen läser den
    // för att visa senaste körning per källtyp.
    match /ingestion_logs/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
